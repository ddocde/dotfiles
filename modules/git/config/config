[init]
    defaultBranch = main
[fetch]
    prune = true
[push]
    autoSetupRemote = true
[merge]
    conflictStyle = zdiff3
[log]
    date = iso
[alias]
    lg = log --graph --decorate --oneline --all
    st = status --short --branch
[core]
    excludesFile = ~/.config/git/ignore
[include]
    path = ~/.config/git/config.local
[include]
    path = ~/.config/git/delta
